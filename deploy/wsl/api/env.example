# Konfigurace API pro nativní běh ve WSL. Zkopíruje se do backend/.env.

# DB v distru kucharka-db (mirrored networking → localhost)
DATABASE_URL=mysql+pymysql://kucharka:kucharka@127.0.0.1:3306/kucharka?charset=utf8mb4

# CORS pro odlazení (frontend běží na jiném originu/portu)
CORS_ORIGINS=*

# Volitelné integrace (prázdné = vypnuto)
# Ollama běží na TrueNASu 172.24.1.111. Z WSL je to LAN adresa (funguje vždy,
# nezávisle na mirrored režimu). Model nastav na ten, který máš stažený
# (ověř: curl http://172.24.1.111:11434/api/tags).
OLLAMA_URL=http://172.24.1.111:11434
OLLAMA_MODEL=qwen3:8b

# --- Komerční LLM API (volitelné, místo Ollamy pro dávkové úlohy) ---
# LLM_PROVIDER=api přepne párování/tagy/kategorie na OpenAI-kompatibilní API
# (OpenAI, DeepSeek, Groq, Mistral, OpenRouter…). Ollama pak slouží jen na
# embeddingy/OCR/RAG. Jde nastavit i za běhu v Administraci → Nástroje.
LLM_PROVIDER=ollama
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_API_MODEL=gpt-4o-mini

SEARXNG_URL=
RECIPE_DOMAINS=
SCRAPE_DELAY=1.0
# TLS ověřování při scrapování. Za firemní proxy, kterou nelze obejít, dej false.
SCRAPER_VERIFY_SSL=true

# --- Autonomní crawler (sám plní DB) ---
# Plánovaný běh na pozadí (true = zapnuto). Tlačítko v UI funguje vždy.
CRAWLER_ENABLED=false
CRAWLER_INTERVAL_MIN=360
CRAWLER_MAX_PER_RUN=15
# Dorůstání surovin: chybějící surovinu doplní Ollama (odhad výživy)
AUTO_INGREDIENTS=true
# Překlad zahraničních receptů do češtiny (vyžaduje Ollamu)
TRANSLATE_TO_CS=true
# Vlastní seed dotazy (čárkou); prázdné = výchozí sada českých jídel
CRAWLER_SEEDS=
# RAG generování receptů (vyžaduje Ollamu + embed model)
EMBED_MODEL=nomic-embed-text
RAG_K=6
# Strop RAG indexu – kolik nejlépe hodnocených receptů se embedduje (0 = vše;
# u 100k+ receptů nechte strop, indexace i paměť zůstanou v rozumných mezích)
RAG_MAX_RECIPES=20000
# Self-update z Gitu přes WEB UI (na TrueNAS true; ve WSL volitelné)
UPDATE_ENABLED=false
# Volitelné zabezpečení heslem (jinak nastav v Admin → Zabezpečení)
APP_PASSWORD=
